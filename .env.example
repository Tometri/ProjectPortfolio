# ============================================================================
# .env.example — Template for environment variables used by portfolio scripts
# ============================================================================
# Copy this file to .env and fill in your values. The .env file is gitignored
# so your secrets stay local.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your values
# ============================================================================

# GitHub Pages base URL (used by update_pages.py for link generation)
PAGES_BASE_URL=https://tometri.github.io/ProjectPortfolio/

# GitHub repository URL
REPO_URL=https://github.com/Tometri/ProjectPortfolio

# Database path (default: data/labs-certs.db)
DATABASE_PATH=data/labs-certs.db

# Backup directory for database snapshots (default: data/backups/)
BACKUP_DIR=data/backups/

# Log level for scripts (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
