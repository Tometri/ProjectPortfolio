# ============================================================================
# .gitignore — Files and directories excluded from version control
# ============================================================================

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Editors and IDEs
.vscode/
.idea/
*.swp
*.swo
*.tmp

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Logs
*.log

# Google ADK and environment secrets (keep .env.example tracked)
.env

# Database backups (the main .db is tracked; backups are local only)
data/backups/
