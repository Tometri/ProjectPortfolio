# =============================================================================
# .gitignore — ProjectPortfolio repository
# =============================================================================

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Editors and IDEs
.vscode/
.idea/
.vs/
*.swp
*.swo
*.tmp

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Logs
*.log

# Google ADK
*.env

# Database files — regenerated by scripts/database.py
# Keep the schema, not the binary data
data/*.db

# Config files with secrets
config/settings.env