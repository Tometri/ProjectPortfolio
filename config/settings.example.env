# =============================================================================



# settings.example.env — Example configuration for ProjectPortfolio



# =============================================================================



#



# Copy this file to config/settings.env and fill in your values.



# The settings.env file is gitignored and will NOT be committed.



#



# These settings are reserved for future expansion, such as syncing



# with external services (Notion, LinkedIn, etc.).



# =============================================================================







# -- Database Settings --



# Path to the SQLite database (relative to repo root)



DB_PATH=data/labs-certs.db







# -- Future: Notion Integration --



# NOTION_API_KEY=your_notion_api_key_here



# NOTION_DATABASE_ID=your_database_id_here







# -- Future: LinkedIn Integration --



# LINKEDIN_ACCESS_TOKEN=your_token_here







# -- Future: GitHub API --



# GITHUB_TOKEN=your_github_pat_here







# -- Export Settings --



# EXPORT_FORMAT=markdown  # markdown, json, or both



# EXPORT_PATH=data/



